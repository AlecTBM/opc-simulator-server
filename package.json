{
  "name": "opc-simulator-server",
  "version": "1.0.0",
  "description": "Configurable OPC UA simulation server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:debug": "LOG_LEVEL=debug nodemon src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint ./src/**",
    "lint:fix": "eslint ./src/** --fix"
  },
  "keywords": [
    "opc-ua",
    "opcua",
    "simulator",
    "industrial",
    "iot"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "node-opcua": "^2.187.26",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1"
  },
  "devDependencies": {
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
