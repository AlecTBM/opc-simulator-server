[
  {
    "id": "tab_opc_test",
    "type": "tab",
    "label": "OPC UA Connection Test",
    "disabled": false,
    "info": "Git-managed baseline flow. Subscribe to Fjordgløtt RawTank1 Level."
  },
  {
    "id": "inject_subscribe",
    "type": "inject",
    "z": "tab_opc_test",
    "name": "Subscribe RawTank1 Level",
    "props": [
      { "p": "topic", "vt": "str" },
      { "p": "action", "v": "subscribe", "vt": "str" },
      { "p": "interval", "v": "500", "vt": "num" }
    ],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "ns=1;s=FG.Process.RawTank1.Level;datatype=Double",
    "x": 190,
    "y": 120,
    "wires": [["opc_client"]]
  },
  {
    "id": "opc_client",
    "type": "OpcUa-Client",
    "z": "tab_opc_test",
    "endpoint": "opc_endpoint",
    "action": "subscribe",
    "deadbandtype": "a",
    "deadbandvalue": 0,
    "time": 1,
    "timeUnit": "s",
    "certificate": "None",
    "localfile": "",
    "localkeyfile": "",
    "securitymode": "None",
    "securitypolicy": "None",
    "useTransport": false,
    "maxChunkCount": 1,
    "maxMessageSize": 8192,
    "receiveBufferSize": 8192,
    "sendBufferSize": 8192,
    "setstatusandtime": false,
    "keepsessionalive": true,
    "name": "OPC Simulator",
    "x": 470,
    "y": 120,
    "wires": [["function_value"], [], []]
  },
  {
    "id": "function_value",
    "type": "function",
    "z": "tab_opc_test",
    "name": "Normalize OPC value",
    "func": "let value = msg.payload;\nif (value && typeof value === 'object' && value.value !== undefined) value = value.value;\nif (value && typeof value === 'object' && value.value !== undefined) value = value.value;\nmsg.payload = value;\nmsg.topic = 'FG.Process.RawTank1.Level';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
    "y": 120,
    "wires": [["debug_value"]]
  },
  {
    "id": "debug_value",
    "type": "debug",
    "z": "tab_opc_test",
    "name": "RawTank1 Level",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 940,
    "y": 120,
    "wires": []
  },
  {
    "id": "opc_endpoint",
    "type": "OpcUa-Endpoint",
    "endpoint": "opc.tcp://opc-simulator:4840/UA/Cpro",
    "secpol": "None",
    "secmode": "None",
    "login": false,
    "usercert": false,
    "usercertificate": "",
    "userprivatekey": ""
  }
]
