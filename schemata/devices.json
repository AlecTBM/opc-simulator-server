{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^.+$": {
      "$ref": "#/$defs/rootFolder"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "nodeId": {
      "type": "string",
      "pattern": "^ns=\\d+;(i=\\d+|s=.+|g=[0-9a-fA-F-]+|b=.+)$"
    },
    "condition": {
      "type": "object",
      "properties": {
        "nodeNs": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "nodeNs",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "logic": {
          "type": "string",
          "enum": [
            "AND",
            "OR"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "required": [
        "logic",
        "items"
      ],
      "additionalProperties": false
    },
    "rootFolder": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "name",
        "items"
      ]
    },
    "folder": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "id",
        "name",
        "items"
      ],
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "randomize",
            "sinus",
            "anomaly",
            "conditional",
            "mapping"
          ]
        },
        "interval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "value": {
          "type": "number"
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "trueValue": {
          "$ref": "#/$defs/value"
        },
        "falseValue": {
          "$ref": "#/$defs/value"
        },
        "randomize": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "base": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max",
            "base"
          ],
          "additionalProperties": false
        },
        "sinus": {
          "type": "object",
          "properties": {
            "amplitude": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            }
          },
          "required": [
            "amplitude",
            "offset"
          ],
          "additionalProperties": false
        },
        "anomaly": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "ends": {
              "type": "boolean"
            },
            "targetValue": {
              "$ref": "#/$defs/value"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "targetValue",
            "threshold",
            "duration"
          ],
          "additionalProperties": false
        },
        "mapping": {
          "$ref": "#/$defs/mapping"
        }
      },
      "required": [
        "type",
        "interval"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "conditional"
              }
            }
          },
          "then": {
            "required": [
              "conditions",
              "trueValue",
              "falseValue"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mapping"
              }
            }
          },
          "then": {
            "required": [
              "mapping"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "simulation": {
          "$ref": "#/$defs/simulation"
        },
        "valueMethods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "get",
              "set"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "valueMethods"
      ],
      "additionalProperties": false
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/folder"
        },
        {
          "$ref": "#/$defs/node"
        }
      ]
    },
    "mapping": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "defaultValue": {
          "$ref": "#/$defs/value"
        },
        "bidirectional": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "map"
      ],
      "additionalProperties": false
    }
  }
}
